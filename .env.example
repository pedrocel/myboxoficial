# API da My Box (VPS). Local: rode `npm run api:dev` (porta 3020).
# Em producao, no Cloudflare Pages: VITE_API_URL=https://api.myboxoficial.com.br
VITE_API_URL=http://localhost:3020

# Endpoint que grava o lead de franquia (landing) e avisa por e-mail.
# Vazio usa o padrao: https://myboxfranquia.myboxoficial.com.br/api/lead
VITE_LEAD_ENDPOINT=
