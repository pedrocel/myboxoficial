VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Ou use a chave anon JWT legada:
# VITE_SUPABASE_ANON_KEY=eyJ...

# Necessário para npm run setup:supabase (Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

# Endpoint que grava o lead de franquia e avisa por e-mail.
# Vazio usa o padrao: https://myboxfranquia.myboxoficial.com.br/api/lead
VITE_LEAD_ENDPOINT=

# API Laravel legada (opcional)
VITE_API_URL=
VITE_LEADS_API_URL=
