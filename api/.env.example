# Local: copie para .env. Em producao o deploy.sh cria o .env no servidor.
PORT=3020
HOST=127.0.0.1
DATABASE_PATH=./data/mybox.db
STORAGE_DIR=./data/files
PUBLIC_BASE_URL=http://localhost:3020
ALLOWED_ORIGINS=http://localhost:5183
