{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "myboxoficial",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5183"
      ],
      "port": 5183
    },
    {
      "name": "mybox-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "api",
        "run",
        "dev"
      ],
      "port": 3020
    },
    {
      "name": "games-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../my-box-wars && EXPO_PUBLIC_API_URL=http://localhost:3020 npx expo start --web --port 8091"
      ],
      "port": 8091
    }
  ]
}